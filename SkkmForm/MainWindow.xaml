<Window x:Class="SkkmConnector.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=System.Runtime"
        Title="Коннектор Сервера ККМ" Height="840" Width="1180"
        Icon="Assets/app.ico"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="MinWidth" Value="120"/>
        </Style>
        <!-- Единая рамка для всех текстовых полей приложения -->
        <Style TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="BorderBrush" Value="#ABADB3"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <!-- Флажок состояния: только отображение, без редактирования -->
        <Style x:Key="ReadOnlyCheckBox" TargetType="CheckBox">
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,2,12,2"/>
        </Style>

        <!-- Поле состояния: только чтение. Единая ширина в рамках вкладки -->
        <Style x:Key="StatusTextBox" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="#FAFAF0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3,16,3"/>
            <Setter Property="Width" Value="200"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <!-- Метка поля формы: фиксированная ширина, чтобы поля стояли друг под другом -->
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3,8,3"/>
        </Style>

        <!-- Поле ввода формы: единая ширина в рамках вкладки -->
        <Style x:Key="FormTextBox" TargetType="TextBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Width" Value="320"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
        </Style>

        <!-- Таблица ключ-значение в консоли (стиль Postman) -->
        <Style x:Key="KeyValueGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="HeadersVisibility" Value="None"/>
            <Setter Property="GridLinesVisibility" Value="All"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E5E0D5"/>
            <Setter Property="VerticalGridLinesBrush" Value="#E5E0D5"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="Cell"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#FBF9F4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#A8A294"/>
        </Style>

        <!-- Заголовок секции: выделяется цветом, размером и жирностью (как в 1С) -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1F7A1F"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Margin" Value="0,8,0,2"/>
        </Style>

        <!-- Заголовки всех GroupBox — зелёные, крупнее и жирнее, чтобы не сливались с текстом -->
        <Style TargetType="GroupBox">
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="#1F7A1F" FontWeight="Bold" FontSize="13.5"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Заголовки всех Expander — в том же стиле -->
        <Style TargetType="Expander">
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="#1F7A1F" FontWeight="Bold" FontSize="13.5"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Прокрутка содержимого вкладки: и вертикальная, и горизонтальная —
             при сжатии окна/панели поля не обрезаются, а появляется прокрутка -->
        <Style x:Key="TabScroll" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <!-- Горизонтальная прокрутка отключена: содержимое получает конечную ширину,
                 иначе *-колонки DataGrid схлопываются. Широкие ряды переносятся (WrapPanel). -->
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>

        <!-- Поле выбора даты: единый инпут — рамка как у TextBox, внутри дата слева
             и значок календаря справа (открывает мини-календарь) -->
        <Style TargetType="DatePicker">
            <Setter Property="Width" Value="130"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Border BorderBrush="#ABADB3" BorderThickness="1" Background="White" SnapsToDevicePixels="True">
                            <Grid x:Name="PART_Root">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- Текст даты: без собственной рамки/фона (рамку даёт Border) -->
                                <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0"
                                                   BorderThickness="0" Background="Transparent"
                                                   VerticalContentAlignment="Center"/>
                                <!-- Значок календаря справа -->
                                <Button x:Name="PART_Button" Grid.Column="1" Width="22"
                                        MinWidth="0" Padding="0" Margin="0" Cursor="Hand"
                                        Background="Transparent" BorderThickness="0"
                                        ToolTip="Открыть календарь">
                                    <Viewbox Width="14" Height="14">
                                        <Path Stroke="#555555" StrokeThickness="1.3" SnapsToDevicePixels="True"
                                              Data="M2,4 H14 V14 H2 Z M2,7 H14 M5.5,2 V5 M10.5,2 V5"/>
                                    </Viewbox>
                                </Button>
                                <Popup x:Name="PART_Popup" StaysOpen="False"
                                       PlacementTarget="{Binding ElementName=PART_TextBox}"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Поле статуса в верхней панели: только чтение, всегда видно -->
        <Style x:Key="TopField" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="4,0,12,0"/>
            <Setter Property="MinWidth" Value="60"/>
        </Style>

        <!-- Ставки НДС для выбора в таблице позиций -->
        <x:Array x:Key="TaxRates" Type="sys:String">
            <sys:String>none</sys:String>
            <sys:String>0</sys:String>
            <sys:String>10</sys:String>
            <sys:String>20</sys:String>
            <sys:String>22</sys:String>
            <sys:String>10/110</sys:String>
            <sys:String>20/120</sys:String>
            <sys:String>22/122</sys:String>
        </x:Array>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ======================= Верхняя панель: состояние ККМ и последняя операция (как в 1С) ======================= -->
        <Border Grid.Row="0" Background="#F2F2F2" Padding="8,6" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1">
            <StackPanel>
                <!-- Строка состояния ККМ -->
                <StackPanel Orientation="Horizontal">
                    <CheckBox x:Name="DemoModeCheckBox" Content="Демо-режим" VerticalAlignment="Center" Margin="0,2,12,2"
                              ToolTip="Демонстрационный режим: сумма чека ограничена 1000 ₽ (как в Сервере ККМ без лицензии)"/>
                    <CheckBox x:Name="FiscalCheckBox" Content="Фискализирован" Style="{StaticResource ReadOnlyCheckBox}"
                              ToolTip="Признак фискализации кассы. Заполняется по кнопкам «Подключить» и «Получить состояние»."/>
                    <TextBlock Text="Состояние смены:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBox x:Name="ShiftStateNumberBox" Style="{StaticResource TopField}" Width="46" TextAlignment="Right"
                             ToolTip="Номер текущей кассовой смены"/>
                    <TextBox x:Name="ShiftStateTextBox" Style="{StaticResource TopField}" Width="150"
                             ToolTip="Состояние смены: открыта, закрыта или истекла"/>
                </StackPanel>

                <!-- Последняя операция -->
                <TextBlock Text="Последняя операция" Style="{StaticResource SectionHeader}" Margin="0,6,0,2"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Время:" VerticalAlignment="Center"/>
                    <TextBox x:Name="LastOpTimeBox" Style="{StaticResource TopField}" Width="150"
                             ToolTip="Время фискальной операции последнего документа"/>
                    <TextBlock Text="Смена:" VerticalAlignment="Center"/>
                    <TextBox x:Name="LastOpShiftBox" Style="{StaticResource TopField}" Width="56" TextAlignment="Right"
                             ToolTip="Номер смены последнего документа"/>
                    <TextBlock Text="Чек:" VerticalAlignment="Center"/>
                    <TextBox x:Name="LastOpDocNumberBox" Style="{StaticResource TopField}" Width="70" TextAlignment="Right"
                             ToolTip="Номер фискального документа"/>
                    <TextBlock Text="ФП:" VerticalAlignment="Center"/>
                    <TextBox x:Name="LastOpSignBox" Style="{StaticResource TopField}" Width="110"
                             ToolTip="Фискальный признак документа"/>
                    <TextBlock Text="DocId:" VerticalAlignment="Center"/>
                    <TextBox x:Name="LastOpDocIdBox" Style="{StaticResource TopField}" Width="260"
                             ToolTip="Идентификатор документа (используется для повторных запросов и защиты от двойной печати)"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ======================= Контент: вкладки слева, консоль справа (как в 1С) ======================= -->
        <!-- Обе колонки star-размера: сплиттер перераспределяет ширину между ними,
             при изменении окна они масштабируются пропорционально -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*" MinWidth="380"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="1*" MinWidth="300"/>
            </Grid.ColumnDefinitions>

        <TabControl Grid.Column="0" Margin="8,8,0,8">

            <!-- ============ Вкладка: Настройка доступа ============ -->
            <TabItem Header="Настройка доступа">
                <ScrollViewer Style="{StaticResource TabScroll}">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Параметры подключения: метки в колонку, поля одной ширины (как в 1С-обработке) -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Адрес сервера ККМ:" Style="{StaticResource FormLabel}"/>
                            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="HostTextBox" Style="{StaticResource FormTextBox}"
                                       ToolTip="Адрес сервера ККМ одной строкой. Порт через двоеточие необязателен: localhost, 192.168.1.150:12345. Без порта используется 4398."/>
                            <Button    Grid.Row="0" Grid.Column="2" x:Name="PingButton" Content="Проверить связь"
                                       HorizontalAlignment="Left" Margin="12,0,0,0" Click="PingButton_Click"
                                       ToolTip="Подключение к серверу ККМ: проверка связи (версия) и загрузка списка касс. Укажите адрес и токен (если на сервере выключен анонимный доступ REST API)."/>

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Токен:" Style="{StaticResource FormLabel}"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" x:Name="TokenTextBox" Style="{StaticResource FormTextBox}"
                                       ToolTip="Токен пользователя JSON API из веб-консоли сервера ККМ (http://адрес:8866). Может быть пустым, если на сервере разрешен анонимный доступ."/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Terminal id:" Style="{StaticResource FormLabel}"/>
                            <TextBox   Grid.Row="2" Grid.Column="1" x:Name="TerminalIdTextBox" Style="{StaticResource FormTextBox}"
                                       ToolTip="Идентификатор рабочего места (заголовок TerminalId). Необязательный."/>

                            <!-- Секция ККМ -->
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="ККМ" Style="{StaticResource SectionHeader}"/>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Имя ККМ:" Style="{StaticResource FormLabel}"/>
                            <ComboBox  Grid.Row="4" Grid.Column="1" x:Name="DeviceComboBox" DisplayMemberPath="DeviceName"
                                       IsEditable="True" VerticalContentAlignment="Center"
                                       Width="320" HorizontalAlignment="Left" Margin="0,3,0,3"
                                       ToolTip="Имя кассы, зарегистрированной на сервере ККМ. Заполняется из списка устройств или вручную."/>
                            <StackPanel Grid.Row="4" Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0">
                                <Button x:Name="ConnectKktButton" Content="Подключить" Click="ConnectKktButton_Click"
                                        ToolTip="Подключить выбранную кассу: сведения о ФН, устройстве и драйвере (GET kkt). Если список касс пуст — сначала загрузит устройства с сервера."/>
                                <Button x:Name="GetStatusButton" Content="Получить состояние" Click="GetStatusButton_Click"
                                        ToolTip="Запросить текущее состояние ККМ: смена, датчики, предупреждения ФН (GET kkt/status)"/>
                            </StackPanel>

                            <!-- Секция Кассир -->
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="Кассир" Style="{StaticResource SectionHeader}"/>

                            <TextBlock Grid.Row="6" Grid.Column="0" Text="ФИО:" Style="{StaticResource FormLabel}"/>
                            <TextBox   Grid.Row="6" Grid.Column="1" x:Name="CashierNameTextBox" Style="{StaticResource FormTextBox}"
                                       ToolTip="ФИО кассира — печатается на чеках и отчетах"/>

                            <TextBlock Grid.Row="7" Grid.Column="0" Text="ИНН:" Style="{StaticResource FormLabel}"/>
                            <TextBox   Grid.Row="7" Grid.Column="1" x:Name="CashierVatinTextBox" Style="{StaticResource FormTextBox}"
                                       ToolTip="ИНН кассира (необязательно)"/>
                        </Grid>

                        <!-- Кнопки -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,10">
                            <Button x:Name="GetDevicesButton" Content="Получить устройства" Click="GetDevicesButton_Click"
                                    ToolTip="Запросить у сервера список зарегистрированных касс"/>
                        </StackPanel>

                        <!-- Сервер (заполняется по кнопке "Получить состояние") -->
                        <Expander Grid.Row="4" Header="Сервер" Margin="0,0,0,6">
                            <Grid Margin="4,4,0,0" TextBlock.FontWeight="Normal">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Версия:" Style="{StaticResource FormLabel}"/>
                                <TextBox   Grid.Row="0" Grid.Column="1" x:Name="SrvVersionTextBox" Style="{StaticResource StatusTextBox}"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="Драйвер ККМ:" Style="{StaticResource FormLabel}"/>
                                <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal">
                                    <TextBox x:Name="SrvDriverTextBox" Style="{StaticResource StatusTextBox}" Width="120" Margin="0,3,8,3"/>
                                    <TextBox x:Name="SrvDriverVersionTextBox" Style="{StaticResource StatusTextBox}" Width="72" Margin="0,3,16,3"/>
                                </StackPanel>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Вендор:" Style="{StaticResource FormLabel}"/>
                                <TextBox   Grid.Row="1" Grid.Column="1" x:Name="SrvVendorTextBox" Style="{StaticResource StatusTextBox}"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Время на сервере:" Style="{StaticResource FormLabel}"/>
                                <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal">
                                    <TextBox x:Name="SrvComputerTimeTextBox" Style="{StaticResource StatusTextBox}" Width="140" Margin="0,3,16,3"/>
                                    <TextBlock Text="Время ККМ:" Style="{StaticResource FormLabel}"/>
                                    <TextBox x:Name="SrvDeviceTimeTextBox" Style="{StaticResource StatusTextBox}" Width="140" Margin="0,3,16,3"/>
                                </StackPanel>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Модель:" Style="{StaticResource FormLabel}"/>
                                <TextBox   Grid.Row="2" Grid.Column="1" x:Name="SrvModelTextBox" Style="{StaticResource StatusTextBox}"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="№:" Style="{StaticResource FormLabel}"/>
                                <TextBox   Grid.Row="2" Grid.Column="3" x:Name="SrvSerialTextBox" Style="{StaticResource StatusTextBox}"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Прошивка:" Style="{StaticResource FormLabel}"/>
                                <TextBox   Grid.Row="3" Grid.Column="1" x:Name="SrvFirmwareTextBox" Style="{StaticResource StatusTextBox}"/>
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="Конфигурация:" Style="{StaticResource FormLabel}"/>
                                <StackPanel Grid.Row="3" Grid.Column="3" Orientation="Horizontal">
                                    <TextBox x:Name="SrvConfigTextBox" Style="{StaticResource StatusTextBox}" Width="120" Margin="0,3,8,3"/>
                                    <TextBlock Text="Ширина строки:" Style="{StaticResource FormLabel}"/>
                                    <TextBox x:Name="SrvLineLengthTextBox" Style="{StaticResource StatusTextBox}" Width="45" Margin="0,3,16,3"/>
                                </StackPanel>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Организация:" Style="{StaticResource FormLabel}"/>
                                <TextBox   Grid.Row="4" Grid.Column="1" x:Name="SrvOrgTextBox" Style="{StaticResource StatusTextBox}"/>
                                <TextBlock Grid.Row="4" Grid.Column="2" Text="ИНН:" Style="{StaticResource FormLabel}"/>
                                <TextBox   Grid.Row="4" Grid.Column="3" x:Name="SrvOrgVatinTextBox" Style="{StaticResource StatusTextBox}"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Адрес регистрации:" Style="{StaticResource FormLabel}"/>
                                <TextBox   Grid.Row="5" Grid.Column="1" x:Name="SrvAddressTextBox" Style="{StaticResource StatusTextBox}"/>
                                <TextBlock Grid.Row="5" Grid.Column="2" Text="Место:" Style="{StaticResource FormLabel}"/>
                                <TextBox   Grid.Row="5" Grid.Column="3" x:Name="SrvLocationTextBox" Style="{StaticResource StatusTextBox}"/>
                            </Grid>
                        </Expander>

                        <!-- ФН -->
                        <Expander Grid.Row="5" Header="ФН" Margin="0,0,0,6">
                            <Grid Margin="4,4,0,0" TextBlock.FontWeight="Normal">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,0,0,4">
                                    <CheckBox x:Name="FnPresentCheckBox" Content="ФН установлен" Style="{StaticResource ReadOnlyCheckBox}"/>
                                    <CheckBox x:Name="FnErrorCheckBox" Content="Ошибка ФН" Style="{StaticResource ReadOnlyCheckBox}"/>
                                </StackPanel>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="№ ФН:" Style="{StaticResource FormLabel}"/>
                                <TextBox   Grid.Row="1" Grid.Column="1" x:Name="FnSerialTextBox" Style="{StaticResource StatusTextBox}"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Рег. номер:" Style="{StaticResource FormLabel}"/>
                                <TextBox   Grid.Row="1" Grid.Column="3" x:Name="FnRnNumberTextBox" Style="{StaticResource StatusTextBox}"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="ФФД:" Style="{StaticResource FormLabel}"/>
                                <TextBox   Grid.Row="2" Grid.Column="1" x:Name="FnFfdTextBox" Style="{StaticResource StatusTextBox}"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="Кол-во фискализаций:" Style="{StaticResource FormLabel}"/>
                                <TextBox   Grid.Row="2" Grid.Column="3" x:Name="FnFiscCountTextBox" Style="{StaticResource StatusTextBox}"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Дата регистрации:" Style="{StaticResource FormLabel}"/>
                                <TextBox   Grid.Row="3" Grid.Column="1" x:Name="FnRegDateTextBox" Style="{StaticResource StatusTextBox}"/>
                                <TextBlock Grid.Row="3" Grid.Column="2" Text="Срок действия:" Style="{StaticResource FormLabel}"/>
                                <TextBox   Grid.Row="3" Grid.Column="3" x:Name="FnValidityTextBox" Style="{StaticResource StatusTextBox}"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Сайт ФНС:" Style="{StaticResource FormLabel}"/>
                                <TextBox   Grid.Row="4" Grid.Column="1" x:Name="FnFnsUrlTextBox" Style="{StaticResource StatusTextBox}"/>
                                <TextBlock Grid.Row="4" Grid.Column="2" Text="Часовая зона:" Style="{StaticResource FormLabel}"/>
                                <TextBox   Grid.Row="4" Grid.Column="3" x:Name="FnTimeZoneTextBox" Style="{StaticResource StatusTextBox}"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Оператор ОФД:" Style="{StaticResource FormLabel}"/>
                                <TextBox   Grid.Row="5" Grid.Column="1" x:Name="FnOfdNameTextBox" Style="{StaticResource StatusTextBox}"/>
                                <TextBlock Grid.Row="5" Grid.Column="2" Text="ИНН ОФД:" Style="{StaticResource FormLabel}"/>
                                <TextBox   Grid.Row="5" Grid.Column="3" x:Name="FnOfdVatinTextBox" Style="{StaticResource StatusTextBox}"/>

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Дата первого непереданного чека:" Style="{StaticResource FormLabel}" TextWrapping="Wrap"/>
                                <TextBox   Grid.Row="6" Grid.Column="1" x:Name="FnBacklogDateTextBox" Style="{StaticResource StatusTextBox}"/>
                                <TextBlock Grid.Row="6" Grid.Column="2" Text="Номер первого непереданного чека:" Style="{StaticResource FormLabel}" TextWrapping="Wrap"/>
                                <TextBox   Grid.Row="6" Grid.Column="3" x:Name="FnBacklogFirstNumTextBox" Style="{StaticResource StatusTextBox}"/>

                                <TextBlock Grid.Row="7" Grid.Column="0" Text="Количество непереданных документов:" Style="{StaticResource FormLabel}" TextWrapping="Wrap"/>
                                <TextBox   Grid.Row="7" Grid.Column="1" x:Name="FnBacklogCountTextBox" Style="{StaticResource StatusTextBox}"/>
                            </Grid>
                        </Expander>

                        <!-- Режимы и состояние ФН: слева режимы регистрации, справа ошибки ФН (как в 1С) -->
                        <Expander Grid.Row="6" Header="Режимы и состояние ФН" Margin="0,0,0,6">
                            <Grid Margin="4" TextBlock.FontWeight="Normal">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Режимы регистрации -->
                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <TextBlock Text="Sign of agent:" Style="{StaticResource FormLabel}"/>
                                        <TextBox x:Name="SignOfAgentTextBox" Style="{StaticResource StatusTextBox}" Width="56" Margin="0,3,16,3"
                                                 ToolTip="Коды признаков агента (битовая маска)"/>
                                        <TextBlock Text="Automatic number:" Style="{StaticResource FormLabel}"/>
                                        <TextBox x:Name="AutomaticNumberTextBox" Style="{StaticResource StatusTextBox}" Width="120" Margin="0,3,0,3"
                                                 ToolTip="Номер автомата для автоматического режима"/>
                                    </StackPanel>
                                    <UniformGrid Columns="4" HorizontalAlignment="Left">
                                        <CheckBox x:Name="ModeOfflineCheckBox" Content="Offline mode" Style="{StaticResource ReadOnlyCheckBox}"/>
                                        <CheckBox x:Name="ModeEncryptionCheckBox" Content="Шифрование данных" Style="{StaticResource ReadOnlyCheckBox}"/>
                                        <CheckBox x:Name="ModeServiceCheckBox" Content="Услуги" Style="{StaticResource ReadOnlyCheckBox}"/>
                                        <CheckBox x:Name="ModeBsoCheckBox" Content="БСО" Style="{StaticResource ReadOnlyCheckBox}"/>
                                        <CheckBox x:Name="ModeCalcOnlineCheckBox" Content="Расчеты в Интернет" Style="{StaticResource ReadOnlyCheckBox}"/>
                                        <CheckBox x:Name="ModeExcisableCheckBox" Content="Подакцизные товары" Style="{StaticResource ReadOnlyCheckBox}"/>
                                        <CheckBox x:Name="ModeGamblingCheckBox" Content="Азартные игры" Style="{StaticResource ReadOnlyCheckBox}"/>
                                        <CheckBox x:Name="ModeLotteryCheckBox" Content="Лотерея" Style="{StaticResource ReadOnlyCheckBox}"/>
                                        <CheckBox x:Name="ModePawnshopCheckBox" Content="Ломбард" Style="{StaticResource ReadOnlyCheckBox}"/>
                                        <CheckBox x:Name="ModeAssuranceCheckBox" Content="Страхование" Style="{StaticResource ReadOnlyCheckBox}"/>
                                        <CheckBox x:Name="ModeMarkingCheckBox" Content="Маркировка" Style="{StaticResource ReadOnlyCheckBox}"/>
                                        <CheckBox x:Name="ModeVendingCheckBox" Content="Вендинговый автомат" Style="{StaticResource ReadOnlyCheckBox}"/>
                                        <CheckBox x:Name="ModeCateringCheckBox" Content="Общепит" Style="{StaticResource ReadOnlyCheckBox}"/>
                                        <CheckBox x:Name="ModeWholesaleCheckBox" Content="Оптовая торговля" Style="{StaticResource ReadOnlyCheckBox}"/>
                                        <CheckBox x:Name="ModeAutomaticCheckBox" Content="Автоматический режим" Style="{StaticResource ReadOnlyCheckBox}"/>
                                        <CheckBox x:Name="ModePrinterAutoCheckBox" Content="Принтер в автомате" Style="{StaticResource ReadOnlyCheckBox}"/>
                                    </UniformGrid>
                                </StackPanel>

                                <!-- Ошибки и предупреждения ФН -->
                                <Border Grid.Row="0" Grid.Column="1" BorderBrush="#D0D0D0" BorderThickness="1,0,0,0" Padding="12,0,0,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <TextBlock Text="Осталось дней:" Style="{StaticResource FormLabel}"/>
                                            <TextBox x:Name="DaysLeftTextBox" Style="{StaticResource StatusTextBox}" Width="56" Margin="0,3,0,3"/>
                                        </StackPanel>
                                        <CheckBox x:Name="CriticalErrorCheckBox" Content="Критическая ошибка" Style="{StaticResource ReadOnlyCheckBox}"/>
                                        <CheckBox x:Name="NeedReplacementCheckBox" Content="Требуется замена ФН" Style="{StaticResource ReadOnlyCheckBox}"/>
                                        <CheckBox x:Name="MemoryOverflowCheckBox" Content="Память переполнена" Style="{StaticResource ReadOnlyCheckBox}"/>
                                        <CheckBox x:Name="ResourceExhaustedCheckBox" Content="Ресурс ФН исчерпан" Style="{StaticResource ReadOnlyCheckBox}"/>
                                        <CheckBox x:Name="OfdTimeoutCheckBox" Content="Таймаут ОФД" Style="{StaticResource ReadOnlyCheckBox}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Связь и датчики -->
                                <WrapPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,8,0,0">
                                    <CheckBox x:Name="OfdDisconnectedCheckBox" Content="ОФД недоступен" Style="{StaticResource ReadOnlyCheckBox}"/>
                                    <CheckBox x:Name="IsmDisconnectedCheckBox" Content="ИСМ недоступна" Style="{StaticResource ReadOnlyCheckBox}"/>
                                    <CheckBox x:Name="DrawerOpenedCheckBox" Content="Денежный ящик открыт" Style="{StaticResource ReadOnlyCheckBox}"/>
                                    <CheckBox x:Name="CheckPaperCheckBox" Content="Чековая лента" Style="{StaticResource ReadOnlyCheckBox}"/>
                                    <CheckBox x:Name="CoverOpenedCheckBox" Content="Крышка открыта" Style="{StaticResource ReadOnlyCheckBox}"/>
                                    <CheckBox x:Name="BatteryLowCheckBox" Content="Батарея разряжена" Style="{StaticResource ReadOnlyCheckBox}"/>
                                    <CheckBox x:Name="OpenDocumentCheckBox" Content="Открытый документ" Style="{StaticResource ReadOnlyCheckBox}"/>
                                </WrapPanel>
                            </Grid>
                        </Expander>

                        <!-- Список устройств -->
                        <GroupBox Grid.Row="7" Header="Устройства (ККМ)" Padding="4">
                            <DataGrid x:Name="DevicesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      CanUserAddRows="False" SelectionMode="Single" MinHeight="100" MaxHeight="220">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Имя устройства" Binding="{Binding DeviceName}" Width="2*"/>
                                    <DataGridTextColumn Header="Драйвер" Binding="{Binding Driver}" Width="*"/>
                                    <DataGridTextColumn Header="Пул" Binding="{Binding Pool}" Width="*"/>
                                    <DataGridTextColumn Header="Статус" Binding="{Binding DeviceStatusDescription}" Width="2*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ============ Вкладка: Кассовые смены ============ -->
            <TabItem Header="Кассовые смены">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Действия со сменой" FontWeight="Bold" Margin="0,0,0,8"/>
                    <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                        <Button x:Name="OpenShiftButton" Content="Открыть смену" Click="OpenShiftButton_Click" Margin="0,0,8,6"
                                ToolTip="Открытие кассовой смены — формирует фискальный документ «Отчет об открытии смены»"/>
                        <Button x:Name="CloseShiftButton" Content="Z-отчёт" Click="CloseShiftButton_Click" Margin="0,0,8,6"
                                ToolTip="Отчёт с гашением — закрывает кассовую смену и передает итоги в ОФД"/>
                        <Button x:Name="XReportButton" Content="X-отчёт" Click="XReportButton_Click" Margin="0,0,8,6"
                                ToolTip="Отчёт без гашения — печатает промежуточные итоги, смена остаётся открытой"/>
                        <Button x:Name="SettlementReportButton" Content="Отчет о текущем состоянии расчетов" Click="SettlementReportButton_Click" Margin="0,0,8,6"
                                ToolTip="Фискальный отчет о непереданных в ОФД документах и состоянии расчетов"/>
                    </WrapPanel>

                    <!-- Фискальные операции за смену -->
                    <GroupBox Grid.Row="2" Header="Фискальные операции за смену" Padding="4">
                        <DataGrid x:Name="ShiftOpsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  CanUserAddRows="False" SelectionMode="Single"
                                  ToolTip="Счетчики фискальных операций текущей смены. Обновляются после X- и Z-отчетов.">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Вид операции" Binding="{Binding Operation}" Width="2*"/>
                                <DataGridTextColumn Header="Количество" Binding="{Binding Count}" Width="*"/>
                                <DataGridTextColumn Header="Сумма" Binding="{Binding Sum, StringFormat=F2}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ============ Вкладка: Запросы документов ============ -->
            <TabItem Header="Запросы документов">
                <ScrollViewer Style="{StaticResource TabScroll}">
                    <StackPanel Margin="8">
                        <GroupBox Header="Запрос информации по смене" Padding="6" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="ShiftStatusButton" Content="Статус смены" Click="ShiftStatusButton_Click"
                                        ToolTip="Номер и состояние текущей кассовой смены (открыта/закрыта/истекла)"/>
                                <Button x:Name="OverallCountersButton" Content="Запрос счетчиков" Click="OverallCountersButton_Click"
                                        ToolTip="Необнуляемые счетчики ККМ за все время работы"/>
                                <Button x:Name="ShiftCountersButton" Content="Сменные итоги" Click="ShiftCountersButton_Click"
                                        ToolTip="Счетчики фискальных операций за текущую смену"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="Запрос смен за период" Padding="6" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Период с / по:" Style="{StaticResource FormLabel}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <DatePicker x:Name="ShiftsFromDatePicker"
                                                SelectedDateFormat="Short" Margin="0,3,8,3"
                                                ToolTip="Начало периода. Дату можно ввести вручную (дд.мм.гггг) или выбрать в календаре."/>
                                    <DatePicker x:Name="ShiftsToDatePicker"
                                                SelectedDateFormat="Short" Margin="0,3,20,3"
                                                ToolTip="Конец периода. Дату можно ввести вручную (дд.мм.гггг) или выбрать в календаре."/>
                                    <Button x:Name="GetShiftsButton" Content="Получить смены" Click="GetShiftsButton_Click"
                                            ToolTip="Список Z-отчетов (закрытых смен) за указанный период"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Запрос чеков по смене" Padding="6" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Номер смены:" Style="{StaticResource FormLabel}"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBox x:Name="ChecksShiftNumberTextBox" Width="320" Margin="0,3,12,3"
                                             VerticalContentAlignment="Center"
                                             ToolTip="Номер кассовой смены, за которую запрашиваются чеки"/>
                                    <Button x:Name="GetChecksButton" Content="Получить чеки" Click="GetChecksButton_Click"
                                            ToolTip="Список чеков, напечатанных за указанную смену"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Запрос документа и статуса обработки по ИД" Padding="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Ид документа:" Style="{StaticResource FormLabel}"/>
                                <TextBox   Grid.Row="0" Grid.Column="1" x:Name="DocIdTextBox" Width="320" Margin="0,3,0,3"
                                           VerticalContentAlignment="Center"
                                           ToolTip="DocId документа — назначается при печати (см. панель «Последняя операция»)"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Для использования в процессе асинхронной печати"
                                           Foreground="Gray" Margin="0,0,0,6"/>
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                                    <Button x:Name="GetTaskStatusButton" Content="Получить статус обработки" Click="GetTaskStatusButton_Click"
                                            ToolTip="Статус задачи в очереди печати по идентификатору документа"/>
                                    <Button x:Name="GetCheckByIdButton" Content="Получить чек" Click="GetCheckByIdButton_Click"
                                            ToolTip="Данные напечатанного чека по идентификатору документа"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ Вкладка: Денежный ящик ============ -->
            <TabItem Header="Денежный ящик">
                <ScrollViewer Style="{StaticResource TabScroll}">
                <StackPanel Margin="8">
                    <GroupBox Header="Операции с денежным ящиком" Padding="8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Сумма внесения / выемки:" VerticalAlignment="Center" Margin="0,4,4,4"/>
                            <TextBox   Grid.Row="0" Grid.Column="1" x:Name="CashAmountTextBox" Text="0" Width="140"
                                       VerticalContentAlignment="Center" TextAlignment="Right" Margin="0,4,8,4"
                                       ToolTip="Сумма для внесения или выемки наличных"/>
                            <Button    Grid.Row="0" Grid.Column="2" x:Name="CashInButton" Content="Внесение" Click="CashInButton_Click"
                                       ToolTip="Внести указанную сумму в денежный ящик (POST cashin)"/>
                            <Button    Grid.Row="0" Grid.Column="3" x:Name="CashOutButton" Content="Выемка" Click="CashOutButton_Click"
                                       ToolTip="Изъять указанную сумму из денежного ящика (POST cashout)"/>

                            <Button    Grid.Row="1" Grid.Column="0" x:Name="CashBalanceButton" Content="Остаток денег в ящике"
                                       HorizontalAlignment="Left" Margin="0,4,8,4" Click="CashBalanceButton_Click"
                                       ToolTip="Запросить остаток наличных в денежном ящике (GET cash)"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" x:Name="CashBalanceTextBox"
                                       IsReadOnly="True" Background="#FAFAF0" Width="140" TextAlignment="Right"
                                       VerticalContentAlignment="Center" Margin="0,4,8,4"
                                       ToolTip="Текущий остаток наличных в денежном ящике"/>

                            <Button    Grid.Row="2" Grid.Column="0" x:Name="OpenDrawerButton" Content="Открыть денежный ящик"
                                       HorizontalAlignment="Left" Margin="0,4,0,4" Click="OpenDrawerButton_Click"
                                       ToolTip="Открыть денежный ящик без операции (POST cash/open)"/>
                        </Grid>
                    </GroupBox>
                    <TextBlock Foreground="Gray" TextWrapping="Wrap"
                               Text="Касса выбирается в верхней панели, кассир — на вкладке «Настройка доступа». Результат операции отображается в консоли справа."/>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ Вкладка: Чеки ============ -->
            <TabItem Header="Чеки">
                <ScrollViewer Style="{StaticResource TabScroll}">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Кнопки -->
                        <WrapPanel Grid.Row="0" Margin="0,0,0,8">
                            <ComboBox x:Name="TemplateComboBox" Width="330" Margin="0,0,8,6"
                                      VerticalContentAlignment="Center" SelectedIndex="0"
                                      ToolTip="Готовый шаблон чека для быстрого заполнения формы (набор как в 1С-обработке)">
                                <ComboBoxItem Content="Чек с полной оплатой (НДС 20)"/>
                                <ComboBoxItem Content="Чек с полной оплатой со скидкой (Без НДС)"/>
                                <ComboBoxItem Content="Чек безналичной оплаты (карта)"/>
                                <ComboBoxItem Content="Чек со смешанной оплатой (нал + безнал)"/>
                                <ComboBoxItem Content="Чек с зачетом аванса (предоплата)"/>
                                <ComboBoxItem Content="Чек в кредит (постоплата)"/>
                                <ComboBoxItem Content="Чек продажи юрлицу за наличные"/>
                                <ComboBoxItem Content="Чек физлицу с уведомлением СМС"/>
                                <ComboBoxItem Content="Электронный чек (на почту, без печати)"/>
                                <ComboBoxItem Content="Возврат прихода"/>
                                <ComboBoxItem Content="Расход (выдача средств)"/>
                                <ComboBoxItem Content="Чек коррекции прихода (ФФД 1.2)"/>
                            </ComboBox>
                            <Button x:Name="FillTemplateButton" Content="Заполнить" Click="FillTemplateButton_Click" Margin="0,0,8,6"
                                    ToolTip="Заполнить форму чека выбранным шаблоном"/>
                            <Button x:Name="PrintCheckButton" Content="Печать чека" Click="PrintCheckButton_Click" Margin="0,0,8,6"
                                    ToolTip="Синхронная печать — запрос ожидает результата печати на кассе"/>
                            <Button x:Name="PrintCheckAsyncButton" Content="Печать чека асинхронно" Click="PrintCheckAsyncButton_Click" Margin="0,0,8,6"
                                    ToolTip="Чек ставится в очередь печати сервера, результат можно запросить позже по DocId"/>
                            <Button x:Name="PrintCheckCorrection120Button" Content="Печать чека коррекции" Click="PrintCheckCorrection120Button_Click" Margin="0,0,8,6"
                                    ToolTip="Чек коррекции ФФД 1.2 (POST correction120)"/>
                        </WrapPanel>

                        <!-- Основные реквизиты (переносятся при нехватке ширины) -->
                        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
                            <TextBlock Text="Система налогообложения:" VerticalAlignment="Center" Margin="0,0,4,6"/>
                            <ComboBox  x:Name="TaxVariantComboBox" Width="210" Margin="0,0,16,6"
                                       VerticalContentAlignment="Center" SelectedIndex="0"
                                       ToolTip="Система налогообложения, по которой пробивается чек">
                                <ComboBoxItem Content="Общая" Tag="0"/>
                                <ComboBoxItem Content="УСН (Доход)" Tag="1"/>
                                <ComboBoxItem Content="УСН (Доход минус Расход)" Tag="2"/>
                                <ComboBoxItem Content="ЕНВД" Tag="3"/>
                                <ComboBoxItem Content="ЕСХН" Tag="4"/>
                                <ComboBoxItem Content="Патент" Tag="5"/>
                            </ComboBox>
                            <TextBlock Text="Тип расчета:" VerticalAlignment="Center" Margin="0,0,4,6"/>
                            <ComboBox  x:Name="PaymentTypeComboBox" Width="210" Margin="0,0,16,6"
                                       VerticalContentAlignment="Center" SelectedIndex="1"
                                       ToolTip="Вид кассовой операции (enum CheckTypes сервера)">
                                <ComboBoxItem Content="Отмена чека" Tag="0"/>
                                <ComboBoxItem Content="Приход (продажа)" Tag="1"/>
                                <ComboBoxItem Content="Возврат прихода" Tag="2"/>
                                <ComboBoxItem Content="Аннулирование" Tag="3"/>
                                <ComboBoxItem Content="Расход (покупка)" Tag="4"/>
                                <ComboBoxItem Content="Возврат расхода" Tag="5"/>
                                <ComboBoxItem Content="Аннулирование покупки" Tag="6"/>
                                <ComboBoxItem Content="Коррекция прихода" Tag="7"/>
                                <ComboBoxItem Content="Коррекция возврата прихода" Tag="8"/>
                                <ComboBoxItem Content="Коррекция расхода" Tag="9"/>
                                <ComboBoxItem Content="Коррекция возврата расхода" Tag="10"/>
                            </ComboBox>
                            <CheckBox  x:Name="ElectronicallyCheckBox" Content="Электронный чек"
                                       VerticalAlignment="Center" Margin="0,0,0,6"
                                       ToolTip="Чек формируется только в электронном виде, без печати на бумаге (нужен e-mail или телефон покупателя)"/>
                        </WrapPanel>

                        <!-- Корректировка (POST correction120, ФФД 1.2) — названия полей как в 1С -->
                        <GroupBox Grid.Row="2" Header="Корректировка (для ФФД 1.2)" Padding="4" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <CheckBox Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" x:Name="IsCorrectionCheckBox"
                                          Content="Это чек корректировки" VerticalAlignment="Center" Margin="0,0,0,6"
                                          ToolTip="Чек будет отправлен на POST correction120 (ФФД 1.2). Не забудьте выбрать тип расчета «Коррекция …»"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Тип (0-самостоятельно, 1-по предписанию):"
                                           VerticalAlignment="Center" Margin="0,0,4,4"/>
                                <ComboBox  Grid.Row="1" Grid.Column="1" x:Name="CorrectionTypeComboBox"
                                           HorizontalAlignment="Left" Width="220"
                                           VerticalContentAlignment="Center" SelectedIndex="0" Margin="0,0,12,4"
                                           ToolTip="Тип коррекции: 0 - самостоятельно, 1 - по предписанию налогового органа">
                                    <ComboBoxItem Content="0 — Самостоятельно" Tag="0"/>
                                    <ComboBoxItem Content="1 — По предписанию" Tag="1"/>
                                </ComboBox>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Дата корректировки:" VerticalAlignment="Center" Margin="0,0,4,4"/>
                                <DatePicker Grid.Row="1" Grid.Column="3" x:Name="CorrectionDatePicker"
                                            SelectedDateFormat="Short" Margin="0,0,0,4"
                                            ToolTip="Дата совершения корректируемого расчета"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Номер предписания корректировки:"
                                           VerticalAlignment="Center" Margin="0,0,4,4"/>
                                <TextBox   Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" x:Name="CorrectionNumberTextBox"
                                           VerticalContentAlignment="Center" Margin="0,0,0,4"
                                           ToolTip="Номер предписания налогового органа (для коррекции по предписанию)"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Описание корректировки:"
                                           VerticalAlignment="Center" Margin="0,0,4,4"/>
                                <TextBox   Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" x:Name="CorrectionDescriptionTextBox"
                                           VerticalContentAlignment="Center" Margin="0,0,0,4"
                                           ToolTip="Основание коррекции, например номер и дата объяснительной"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Номер корректируемого чека:"
                                           VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox   Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" x:Name="CorrectedCheckNumberTextBox"
                                           VerticalContentAlignment="Center"
                                           ToolTip="Фискальный признак (ФП) корректируемого чека — записывается в тег 1192"/>
                            </Grid>
                        </GroupBox>

                        <!-- Тексты -->
                        <GroupBox Grid.Row="3" Header="Тексты" Padding="4" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="Текст в шапке:" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TextBeforeTextBox" AcceptsReturn="True" Height="52"
                                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                                             ToolTip="Произвольный текст, печатается перед товарной частью чека"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                    <TextBlock Text="Текст в подвале:" Margin="0,0,0,2"/>
                                    <TextBox x:Name="TextAfterTextBox" AcceptsReturn="True" Height="52"
                                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                                             ToolTip="Произвольный текст, печатается после товарной части чека"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <!-- Покупатель -->
                        <GroupBox Grid.Row="4" Header="Покупатель" Padding="4" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Покупатель:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox   Grid.Column="1" x:Name="CustomerInfoTextBox"
                                           ToolTip="Наименование организации или ФИО покупателя (для ИП и юрлиц)"/>
                                <TextBlock Grid.Column="2" Text="ИНН:" VerticalAlignment="Center" Margin="12,0,4,0"/>
                                <TextBox   Grid.Column="3" x:Name="CustomerVatinTextBox"
                                           ToolTip="ИНН покупателя (для ИП и юрлиц)"/>
                                <TextBlock Grid.Column="4" Text="e-mail:" VerticalAlignment="Center" Margin="12,0,4,0"/>
                                <TextBox   Grid.Column="5" x:Name="CustomerEmailTextBox"
                                           ToolTip="Электронная почта для отправки электронного чека"/>
                                <TextBlock Grid.Column="6" Text="Телефон:" VerticalAlignment="Center" Margin="12,0,4,0"/>
                                <TextBox   Grid.Column="7" x:Name="CustomerPhoneTextBox"
                                           ToolTip="Телефон для отправки электронного чека (СМС)"/>
                            </Grid>
                        </GroupBox>

                        <!-- Оплата -->
                        <GroupBox Grid.Row="5" Header="Оплата" Padding="4" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                    <TextBlock Text="Наличными:" Margin="0,0,0,2"/>
                                    <TextBox x:Name="PayCashTextBox" Text="0" ToolTip="Сумма наличной оплаты"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="4,0,4,0">
                                    <TextBlock Text="Безналичными:" Margin="0,0,0,2"/>
                                    <TextBox x:Name="PayElectronicTextBox" Text="0" ToolTip="Сумма оплаты банковской картой или переводом"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="4,0,4,0">
                                    <TextBlock Text="Постоплатой (кредит):" Margin="0,0,0,2"/>
                                    <TextBox x:Name="PayCreditTextBox" Text="0" ToolTip="Сумма постоплатой — товар передан, оплата позже"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" Margin="4,0,4,0">
                                    <TextBlock Text="Предоплатой (аванс):" Margin="0,0,0,2"/>
                                    <TextBox x:Name="PayAdvanceTextBox" Text="0" ToolTip="Сумма зачтенного ранее внесенного аванса"/>
                                </StackPanel>
                                <StackPanel Grid.Column="4" Margin="4,0,0,0">
                                    <TextBlock Text="Встречным (бартер):" Margin="0,0,0,2"/>
                                    <TextBox x:Name="PayProvisionTextBox" Text="0" ToolTip="Сумма встречным предоставлением (бартер)"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <!-- Позиции -->
                        <GroupBox Grid.Row="6" Header="Позиции чека" Padding="4">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <Button x:Name="AddPositionButton" Content="Добавить" MinWidth="90" Click="AddPositionButton_Click"
                                            ToolTip="Добавить новую позицию в чек"/>
                                    <Button x:Name="RemovePositionButton" Content="Удалить" MinWidth="90" Click="RemovePositionButton_Click"
                                            ToolTip="Удалить выделенную позицию из чека"/>
                                    <Button x:Name="MoveUpPositionButton" Content="▲" MinWidth="32" Click="MoveUpPositionButton_Click"
                                            ToolTip="Переместить выделенную позицию вверх"/>
                                    <Button x:Name="MoveDownPositionButton" Content="▼" MinWidth="32" Click="MoveDownPositionButton_Click"
                                            ToolTip="Переместить выделенную позицию вниз"/>
                                    <TextBlock x:Name="TotalTextBlock" Text="Итого: 0.00" VerticalAlignment="Center"
                                               Margin="16,0,0,0" FontWeight="Bold"/>
                                </StackPanel>
                                <DataGrid x:Name="PositionsGrid" AutoGenerateColumns="False" MinHeight="120" MaxHeight="220"
                                          HeadersVisibility="All" RowHeaderWidth="18" GridLinesVisibility="Horizontal"
                                          CanUserAddRows="False" SelectionMode="Single" AllowDrop="True"
                                          CellEditEnding="PositionsGrid_CellEditEnding"
                                          PreviewMouseLeftButtonDown="PositionsGrid_PreviewMouseLeftButtonDown"
                                          PreviewMouseMove="PositionsGrid_PreviewMouseMove"
                                          DragOver="PositionsGrid_DragOver"
                                          Drop="PositionsGrid_Drop"
                                          ToolTip="Позиции чека. Перетаскивайте строки за левый край или используйте кнопки ▲▼.">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="3*"/>
                                        <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="*"/>
                                        <DataGridTextColumn Header="Единица" Binding="{Binding MeasurementUnit}" Width="*"/>
                                        <DataGridTextColumn Header="Цена" Binding="{Binding Price}" Width="*"/>
                                        <DataGridTextColumn Header="Скидка" Binding="{Binding DiscountSum}" Width="*"/>
                                        <DataGridTextColumn Header="Отдел" Binding="{Binding Department}" Width="*"/>
                                        <DataGridComboBoxColumn Header="НДС" SelectedItemBinding="{Binding Tax}"
                                                                ItemsSource="{StaticResource TaxRates}" Width="*"/>
                                        <DataGridTextColumn Header="Сумма" Binding="{Binding Sum, Mode=OneWay}" Width="*" IsReadOnly="True"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </GroupBox>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ============ Вкладка: Картинки ============ -->
            <TabItem Header="Картинки">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Загрузка картинки на сервер -->
                    <GroupBox Grid.Row="0" Header="Загрузка картинки на сервер" Padding="6" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Картинка в формате BMP для загрузки в ККМ:" Margin="0,0,0,4"/>
                                <Border x:Name="PictureBorder" Height="180" BorderBrush="Gray" BorderThickness="1"
                                        Background="White" Cursor="Hand"
                                        MouseLeftButtonDown="PictureBorder_MouseLeftButtonDown"
                                        ToolTip="Нажмите, чтобы выбрать файл картинки (BMP)">
                                    <Grid>
                                        <TextBlock x:Name="PicturePlaceholderText" Text="ВЫБРАТЬ КАРТИНКУ"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="Gray"/>
                                        <Image x:Name="PicturePreviewImage" Stretch="Uniform" Margin="4"/>
                                    </Grid>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Имя файла картинки:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox x:Name="PictureFileTextBox" IsReadOnly="True" MinWidth="150"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="Имя картинки на сервере:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                    <TextBox x:Name="PictureNameTextBox" Width="200"
                                             ToolTip="Под этим именем картинка будет сохранена на сервере ККМ"/>
                                </StackPanel>
                                <Button x:Name="UploadPictureButton" Content="Загрузить картинку на сервер ККМ"
                                        HorizontalAlignment="Left" Click="UploadPictureButton_Click"
                                        ToolTip="Отправить выбранную картинку на сервер ККМ (POST picture)"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <!-- Картинки на сервере -->
                    <GroupBox Grid.Row="1" Header="Картинки на сервере" Padding="6">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Button Grid.Row="0" x:Name="GetPicturesButton" Content="Получить картинки на сервере ККМ"
                                    HorizontalAlignment="Left" Margin="0,0,0,6" Click="GetPicturesButton_Click"
                                    ToolTip="Запросить список картинок, загруженных на сервер для выбранной кассы"/>
                            <DataGrid Grid.Row="1" x:Name="PicturesGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      CanUserAddRows="False" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Имя картинки" Binding="{Binding PictureName}" Width="*"/>
                                    <DataGridTextColumn Header="Выравнивание" Binding="{Binding Alignment}" Width="Auto"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- ============ Вкладка: Маркировка ============ -->
            <TabItem Header="Маркировка">
                <ScrollViewer Style="{StaticResource TabScroll}">
                    <StackPanel Margin="8">
                        <GroupBox Header="Проверка кода маркировки" Padding="8" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Количество предмета расчета:"
                                           VerticalAlignment="Center" Margin="0,4,8,4"/>
                                <TextBox   Grid.Row="0" Grid.Column="1" x:Name="MarkingQuantityTextBox" Text="0" Width="160"
                                           HorizontalAlignment="Left" TextAlignment="Right" Margin="0,4,0,4"
                                           ToolTip="Количество предмета расчёта для запроса КМ"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Планируемый статус маркируемого товара код:"
                                           VerticalAlignment="Center" Margin="0,4,8,4"/>
                                <TextBox   Grid.Row="1" Grid.Column="1" x:Name="PlannedStatusTextBox" Text="0" Width="160"
                                           HorizontalAlignment="Left" TextAlignment="Right" Margin="0,4,0,4"
                                           ToolTip="Тег 2003 ФФД: 1 — реализован, 2 — мерный в стадии реализации, 3 — возвращён, 4 — часть возвращена, 255 — не изменился"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Мера количества предмета расчета ККТКод:"
                                           VerticalAlignment="Center" Margin="0,4,8,4"/>
                                <TextBox   Grid.Row="2" Grid.Column="1" x:Name="MarkingMeasureTextBox" Text="0" Width="160"
                                           HorizontalAlignment="Left" TextAlignment="Right" Margin="0,4,0,4"
                                           ToolTip="Мера количества предмета расчёта, таблица 114 ФФД"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Дробное количество маркированного товара числитель:"
                                           VerticalAlignment="Center" Margin="0,4,8,4"/>
                                <TextBox   Grid.Row="3" Grid.Column="1" x:Name="MarkingFractionNumTextBox" Text="0" Width="160"
                                           HorizontalAlignment="Left" TextAlignment="Right" Margin="0,4,0,4"/>

                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Дробное количество маркированного товара знаменатель:"
                                           VerticalAlignment="Center" Margin="0,4,8,4"/>
                                <TextBox   Grid.Row="4" Grid.Column="1" x:Name="MarkingFractionDenTextBox" Text="0" Width="160"
                                           HorizontalAlignment="Left" TextAlignment="Right" Margin="0,4,0,4"/>

                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Имя ККМ:"
                                           VerticalAlignment="Center" Margin="0,4,8,4"/>
                                <TextBox   Grid.Row="5" Grid.Column="1" x:Name="MarkingDeviceTextBox" Width="240"
                                           HorizontalAlignment="Left" Margin="0,4,0,4"
                                           ToolTip="Имя устройства на сервере ККМ. Если пусто — берётся касса из верхней панели."/>

                                <TextBlock Grid.Row="6" Grid.Column="0" Text="Код маркировки:"
                                           VerticalAlignment="Center" Margin="0,4,8,4"/>
                                <TextBox   Grid.Row="6" Grid.Column="1" x:Name="MarkingCodeTextBox"
                                           MinWidth="360" HorizontalAlignment="Stretch" Margin="0,4,0,4"
                                           ToolTip="Код маркировки в Base64 (как в обработке 1С)"/>

                                <Button Grid.Row="7" Grid.Column="0" x:Name="OpenKmSessionButton"
                                        Content="Открыть сессию проверки КМ" HorizontalAlignment="Left"
                                        Margin="0,10,8,4" Click="OpenKmSessionButton_Click"
                                        ToolTip="POST marking/session/open"/>
                                <Button Grid.Row="8" Grid.Column="0" x:Name="RequestKmButton"
                                        Content="Проверить КМ" HorizontalAlignment="Left"
                                        Margin="0,4,8,4" Click="RequestKmButton_Click"
                                        ToolTip="POST marking/km/request"/>
                                <Button Grid.Row="9" Grid.Column="0" x:Name="GetKmResultButton"
                                        Content="Получить результат проверки КМ" HorizontalAlignment="Left"
                                        Margin="0,4,8,4" Click="GetKmResultButton_Click"
                                        ToolTip="GET marking/km/result"/>
                                <Button Grid.Row="10" Grid.Column="0" x:Name="CloseKmSessionButton"
                                        Content="Закрыть сессию проверки КМ" HorizontalAlignment="Left"
                                        Margin="0,4,8,4" Click="CloseKmSessionButton_Click"
                                        ToolTip="POST marking/session/close"/>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============ Вкладка: Текст (нефискальный документ) ============ -->
            <TabItem Header="Текст">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Копия документа -->
                    <GroupBox Grid.Row="0" Header="Копия документа" Padding="6" Margin="0,0,0,8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="Фискальный признак:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                <TextBox x:Name="CopyFiscalSignTextBox" Width="250"
                                         ToolTip="Фискальный признак или DocId документа, копию которого нужно напечатать"/>
                            </StackPanel>
                            <TextBlock Text="Если пусто — то печать копии последнего документа" Foreground="Gray" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="PrintCopyButton" Content="Копия документа" HorizontalAlignment="Left" Click="PrintCopyButton_Click"
                                        ToolTip="Печать копии документа: по фискальному признаку/DocId, либо копия последнего документа"/>
                                <Button x:Name="GetFormButton" Content="Получить печатную форму" HorizontalAlignment="Left" Click="GetFormButton_Click"
                                        ToolTip="Получить построчную печатную форму документа по DocId (GET task/form)"/>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>

                    <!-- Печать текста -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button x:Name="FillSlipTextButton" Content="Заполнить текст" Click="FillSlipTextButton_Click"
                                ToolTip="Заполнить поле примером текста с разметкой (выравнивание, шрифты, QR-код)"/>
                        <Button x:Name="PrintSlipButton" Content="Печать" Click="PrintSlipButton_Click"
                                ToolTip="Печать нефискального документа — произвольный текст без фискальных данных"/>
                        <Button x:Name="PrintSlipAsyncButton" Content="Печать асинхронно" Click="PrintSlipAsyncButton_Click"
                                ToolTip="Нефискальный документ ставится в очередь печати сервера"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,4"
                               Text="Разметка в начале строки: [left|right|center|width] — выравнивание, [normal|bold|small|medium|big|h1..h5] — шрифт, [QR|EAN13|EAN8|CODE39|CODE128] — штрихкод, [line] — разделительная линия (стиль: [line,solid|bold|dashed|dotted|double]). Теги можно совмещать через запятую: [center,bold]Заголовок"/>

                    <TextBox Grid.Row="3" x:Name="SlipTextBox" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                             HorizontalScrollBarVisibility="Auto" FontFamily="Consolas"
                             VerticalContentAlignment="Top"
                             ToolTip="Текст для печати. Каждая строка — отдельная строка на чековой ленте."/>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Разделитель между вкладками и консолью.
             ResizeBehavior=PreviousAndNext + обе star-колонки — плавное перераспределение без «прыжков» -->
        <GridSplitter Grid.Column="1" Width="6" VerticalAlignment="Stretch" HorizontalAlignment="Center"
                      ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                      Background="#C4C0B4" ShowsPreview="False" Margin="4,8,0,8"/>

        <!-- ======================= Правая панель: консоль запроса/ответа ======================= -->
        <Grid Grid.Column="2" Margin="2,8,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="80"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1.5*" MinHeight="100"/>
            </Grid.RowDefinitions>

            <!-- Строка запроса -->
            <Border Grid.Row="0" Background="#4A4668" Padding="8,5" CornerRadius="3,3,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <TextBlock x:Name="RequestMethodTextBlock" Text=""
                                   Foreground="#FFB020" FontFamily="Consolas" FontWeight="Bold" Margin="0,0,10,0"/>
                        <TextBlock x:Name="RequestUrlTextBlock" Text="Запрос еще не выполнялся"
                                   Foreground="#7CE87C" FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock x:Name="RequestStatsTextBlock" Text=""
                                   Foreground="#CCCCCC" FontFamily="Consolas" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Параметры и заголовки (таблицы, как в Postman) -->
            <TabControl Grid.Row="1" Height="120" Margin="0,4,0,0">
                <TabItem Header="Параметры">
                    <DataGrid x:Name="ParamsGrid" Style="{StaticResource KeyValueGrid}"
                              ToolTip="Параметры строки запроса (GET)">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Key}" Width="*"/>
                            <DataGridTextColumn Binding="{Binding Value}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
                <TabItem Header="Заголовки">
                    <DataGrid x:Name="HeadersGrid" Style="{StaticResource KeyValueGrid}"
                              ToolTip="HTTP-заголовки, отправленные с запросом">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Key}" Width="*"/>
                            <DataGridTextColumn Binding="{Binding Value}" Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </TabItem>
            </TabControl>

            <!-- Тело запроса -->
            <RichTextBox Grid.Row="2" x:Name="RequestBox" IsReadOnly="True" Margin="0,4,0,0"
                         Background="#2D2B55" BorderThickness="0"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         ToolTip="Тело POST-запроса (JSON)"/>

            <!-- Код и время выполнения -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="Код:" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <TextBox x:Name="ResultCodeTextBox" IsReadOnly="True" Width="60" VerticalContentAlignment="Center"
                         ToolTip="Код ошибки из ответа сервера (0 — успех)"/>
                <TextBlock Text="Время (мс):" VerticalAlignment="Center" Margin="12,0,4,0"/>
                <TextBlock x:Name="DurationTextBlock" Text="" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Описание результата -->
            <TextBox Grid.Row="4" x:Name="ResultDescriptionTextBox" IsReadOnly="True" Margin="0,4,0,0"
                     VerticalContentAlignment="Center"
                     ToolTip="Описание результата из ответа сервера"/>

            <!-- Ответ -->
            <RichTextBox Grid.Row="5" x:Name="ConsoleBox" IsReadOnly="True" Margin="0,4,0,0"
                         Background="#2D2B55" BorderThickness="0"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         ToolTip="Ответ сервера"/>
        </Grid>
        </Grid>
    </Grid>
</Window>
