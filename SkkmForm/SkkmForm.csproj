<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <RootNamespace>SkkmConnector</RootNamespace>
    <AssemblyTitle>Форма коннектора Сервера ККМ</AssemblyTitle>
    <Description>Пример формы коннектора Сервера ККМ. Подключает SkkmConnector по ProjectReference.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\skkm4-logo.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SkkmConnector\SkkmConnector.csproj" />
  </ItemGroup>

</Project>
